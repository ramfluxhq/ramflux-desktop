pkgbase = ramflux-desktop-bin
	pkgdesc = Desktop client of Ramflux: end-to-end encrypted messaging and agents
	pkgver = 0.2.6
	pkgrel = 1
	url = https://github.com/ramfluxhq/ramflux-desktop
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-or-later
	depends = alsa-lib
	depends = fontconfig
	depends = freetype2
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = ramflux-cli-bin: the rf daemon the desktop connects to, and rf-tui
	optdepends = gnome-keyring: Secret Service for keys, once the daemon uses it
	optdepends = xdg-desktop-portal: native file dialogs and light/dark following
	optdepends = vulkan-driver: GPU rendering (otherwise a GLES fallback is tried)
	provides = ramflux-desktop
	conflicts = ramflux-desktop
	options = !strip
	options = !debug
	source_x86_64 = https://github.com/ramfluxhq/ramflux-desktop/releases/download/v0.2.6/ramflux-desktop-0.2.6-linux-x86_64.tar.gz
	sha256sums_x86_64 = REPLACE_WITH_SHA256_OF_THE_X86_64_ARCHIVE
	source_aarch64 = https://github.com/ramfluxhq/ramflux-desktop/releases/download/v0.2.6/ramflux-desktop-0.2.6-linux-aarch64.tar.gz
	sha256sums_aarch64 = REPLACE_WITH_SHA256_OF_THE_AARCH64_ARCHIVE

pkgname = ramflux-desktop-bin
