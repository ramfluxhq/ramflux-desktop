// s06 Work in progress: a one-sentence request starts a multi-step task. The
// task needs the user midway (a medium-risk seat hold), then completes.
// Demonstrates: TaskUpserted, TaskStepChanged, a TaskProgress moment moving
// InProgress -> NeedsMe -> InProgress -> Done, and chained response rules
// (task.start, then grant.approve).
// Moment `at` values are stamped by the mock source at delivery time.
#![enable(implicit_some, unwrap_variant_newtypes)]
(
    name: "s06_in_progress",
    description: "One-sentence request, multi-step task, needs me midway, completes",
    timeline: [
        (0, SourceStatusChanged(Connected)),
        (0, ParticipantUpserted(id: "p-me", kind: Human, display: "Alex Moreau")),
        (0, ParticipantUpserted(id: "p-orbit", kind: Agent, display: "Orbit", contact: true)),
        (10, ContextUpserted(id: "c-trip", kind: Direct, title: "Orbit", participants: ["p-me", "p-orbit"])),
        (100, MomentAdded(id: "m-hello", context_id: "c-trip", origin: "p-orbit", at: 0,
            kind: Message(text: "What should I take care of today?"), lifecycle: Done)),
    ],
    responses: [
        (
            on: Call(method: "task.start", fields: {"context_id": "c-trip"}),
            emit: [
                (50, TaskUpserted(
                    id: "t-trip",
                    intent_id: "i-trip",
                    context_id: "c-trip",
                    actor: Human,
                    title: "Book a train to Lyon on Friday morning",
                    steps: [
                        (label: "Search connections", lifecycle: Pending),
                        (label: "Compare fares", lifecycle: Pending),
                        (label: "Hold a seat", lifecycle: Pending),
                        (label: "Confirm booking", lifecycle: Pending),
                    ],
                    lifecycle: InProgress,
                )),
                (60, MomentAdded(id: "m-task", context_id: "c-trip", origin: "p-orbit", at: 0,
                    kind: TaskProgress(task_id: "t-trip"), lifecycle: InProgress)),
                (500, TaskStepChanged(task_id: "t-trip", index: 0, lifecycle: InProgress)),
                (1500, TaskStepChanged(task_id: "t-trip", index: 0, lifecycle: Done)),
                (1600, TaskStepChanged(task_id: "t-trip", index: 1, lifecycle: InProgress)),
                (2500, TaskStepChanged(task_id: "t-trip", index: 1, lifecycle: Done)),
                (2600, GrantRequested(
                    id: "g-hold",
                    scope: "travel.hold_seat",
                    risk: Medium,
                    args_hash: "sha256:1d0f5c3b8a77",
                )),
                (2600, TaskUpserted(
                    id: "t-trip",
                    intent_id: "i-trip",
                    context_id: "c-trip",
                    actor: Human,
                    title: "Book a train to Lyon on Friday morning",
                    steps: [
                        (label: "Search connections", lifecycle: Done),
                        (label: "Compare fares", lifecycle: Done),
                        (label: "Hold a seat", lifecycle: NeedsMe),
                        (label: "Confirm booking", lifecycle: Pending),
                    ],
                    lifecycle: NeedsMe,
                )),
                (2600, MomentUpdated(moment_id: "m-task", lifecycle: NeedsMe)),
                (2600, MomentAdded(id: "m-hold", context_id: "c-trip", origin: "p-orbit", at: 0,
                    kind: Intervention(grant_id: "g-hold", risk: Medium,
                        summary: "Hold seat 42A on the 07:58 train for 64 EUR"),
                    lifecycle: NeedsMe)),
            ],
        ),
        (
            on: Call(method: "grant.approve", fields: {"grant_id": "g-hold"}),
            emit: [
                (100, GrantResolved(grant_id: "g-hold", state: Approved)),
                (100, MomentUpdated(moment_id: "m-hold", lifecycle: Done)),
                (150, TaskStepChanged(task_id: "t-trip", index: 2, lifecycle: InProgress)),
                (150, MomentUpdated(moment_id: "m-task", lifecycle: InProgress)),
                (800, TaskStepChanged(task_id: "t-trip", index: 2, lifecycle: Done)),
                (900, TaskStepChanged(task_id: "t-trip", index: 3, lifecycle: InProgress)),
                (1600, TaskUpserted(
                    id: "t-trip",
                    intent_id: "i-trip",
                    context_id: "c-trip",
                    actor: Human,
                    title: "Book a train to Lyon on Friday morning",
                    steps: [
                        (label: "Search connections", lifecycle: Done),
                        (label: "Compare fares", lifecycle: Done),
                        (label: "Hold a seat", lifecycle: Done),
                        (label: "Confirm booking", lifecycle: Done),
                    ],
                    lifecycle: Done,
                )),
                (1600, MomentUpdated(moment_id: "m-task", lifecycle: Done)),
            ],
        ),
    ],
)
