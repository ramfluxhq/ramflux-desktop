// s12 Renderer limits at the reducer edge: one surface arrives with more
// actions than the renderer allows (17 of 16) and shows only its fallback
// text; another streams text until one delta is larger than 4,096 bytes,
// after which it too shows only its fallback text (never a partial
// rendering) and takes no further changes; its author can still close it.
#![enable(implicit_some, unwrap_variant_newtypes)]
(
    name: "s12_surface_limits",
    description: "A surface over the action limit and a stream over the delta limit",
    timeline: [
        (0, SourceStatusChanged(Connected)),
        (0, ListingsLoaded([Nodes, Accounts, Contexts, Contacts, Objects, Approvals])),
        (0, AccountUpdated(id: "local", label: "Local", lock_state: Unlocked, self_participant_id: "p-me")),
        (0, ParticipantUpserted(id: "p-me", kind: Human, display: "Alex Moreau")),
        (0, ParticipantUpserted(id: "p-orbit", kind: Agent, display: "Orbit", contact: true)),
        (10, ContextUpserted(id: "c-limits", kind: Direct, title: "Orbit", participants: ["p-me", "p-orbit"])),
        (100, Surface(Create(
            moment_id: "m-many",
            context_id: "c-limits",
            origin: "p-orbit",
            surface_id: "s-many",
            version: 1,
            blocks: [(id: "b-q", kind: Text, data: {"text": "Pick a mirror for the download"})],
            actions: [
                (id: "mirror-01", label: "Mirror 1"),
                (id: "mirror-02", label: "Mirror 2"),
                (id: "mirror-03", label: "Mirror 3"),
                (id: "mirror-04", label: "Mirror 4"),
                (id: "mirror-05", label: "Mirror 5"),
                (id: "mirror-06", label: "Mirror 6"),
                (id: "mirror-07", label: "Mirror 7"),
                (id: "mirror-08", label: "Mirror 8"),
                (id: "mirror-09", label: "Mirror 9"),
                (id: "mirror-10", label: "Mirror 10"),
                (id: "mirror-11", label: "Mirror 11"),
                (id: "mirror-12", label: "Mirror 12"),
                (id: "mirror-13", label: "Mirror 13"),
                (id: "mirror-14", label: "Mirror 14"),
                (id: "mirror-15", label: "Mirror 15"),
                (id: "mirror-16", label: "Mirror 16"),
                (id: "mirror-17", label: "Mirror 17"),
            ],
            fallback_text: "Orbit listed 17 download mirrors.",
        ))),
        (200, Surface(Create(
            moment_id: "m-log",
            context_id: "c-limits",
            origin: "p-orbit",
            surface_id: "s-log",
            version: 1,
            blocks: [(id: "b-log", kind: LogStream, data: {"text": ""})],
            actions: [(id: "stop", label: "Stop the build")],
            fallback_text: "Orbit streamed the build log of release 2.4.0.",
        ))),
        (400, Surface(StreamAppend(surface_id: "s-log", version: 2, block_id: "b-log",
            text_delta: "compiling core\n"))),
        (600, Surface(StreamAppend(surface_id: "s-log", version: 3, block_id: "b-log",
            text_delta: "compiling ui\n"))),
        (800, Surface(StreamAppend(surface_id: "s-log", version: 4, block_id: "b-log",
            text_delta: ""))),
        (1000, Surface(Close(surface_id: "s-log", version: 4))),
    ],
    responses: [],
)
