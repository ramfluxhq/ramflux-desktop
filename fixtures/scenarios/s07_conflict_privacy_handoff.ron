// s07 Contract-first moments not yet backed by the SDK: a CAS conflict on a
// shared object, masked content revealed with an audit record, and a
// cross-device handoff.
// The conflict carries the conflicting lines for a side-by-side compare; a
// reveal needs a hold and is audited.
// Demonstrates: Conflict + ResolveConflict, PrivacyReveal + Reveal (held and
// audited), Handoff + AcceptHandoff / DeclineHandoff.
// Moment `at` values are stamped by the mock source at delivery time.
#![enable(implicit_some, unwrap_variant_newtypes)]
(
    name: "s07_conflict_privacy_handoff",
    description: "Conflict resolution, audited privacy reveal, cross-device handoff",
    timeline: [
        (0, SourceStatusChanged(Connected)),
        (0, ListingsLoaded([Nodes, Accounts, Contexts, Contacts, Objects, Approvals])),
        (0, AccountUpdated(id: "local", label: "Local", lock_state: Unlocked, self_participant_id: "p-me")),
        (0, ParticipantUpserted(id: "p-me", kind: Human, display: "Alex Moreau")),
        (0, ParticipantUpserted(id: "p-lena", kind: Human, display: "Lena Hart", contact: true)),
        (0, ParticipantUpserted(id: "d-desk", kind: Device, display: "Desk workstation")),
        (0, ParticipantUpserted(id: "d-laptop", kind: Device, display: "This laptop")),
        (10, ContextUpserted(id: "c-ledger", kind: Space, title: "Household ledger", participants: ["p-me", "p-lena"], pinned: true)),
        (100, ObjectUpserted(id: "o-budget", name: "budget-2026.ods", size: 18432, direction: Outbound, transfer: Complete)),
        (200, MomentAdded(id: "m-conflict", context_id: "c-ledger", origin: "p-lena", at: 0,
            kind: Conflict(
                object_id: "o-budget",
                local: (version: "v7", summary: "Edited on this laptop: groceries line",
                    lines: ["Rent, 1450", "Groceries, 520", "Utilities, 180", "Transport, 95"]),
                remote: (version: "v8", summary: "Lena edited the utilities line",
                    lines: ["Rent, 1450", "Groceries, 480", "Utilities, 215", "Transport, 95"]),
            ),
            lifecycle: NeedsMe)),
        (300, MomentAdded(id: "m-iban", context_id: "c-ledger", origin: "p-lena", at: 0,
            kind: PrivacyReveal(label: "Bank account number"), lifecycle: Pending)),
        (400, MomentAdded(id: "m-handoff", context_id: "c-ledger", origin: "d-desk", at: 0,
            kind: Handoff(from_device: "d-desk", summary: "Continue reviewing the ledger draft"),
            lifecycle: NeedsMe)),
    ],
    responses: [
        (
            on: Call(method: "handoff.accept", fields: {"moment_id": "m-handoff"}),
            emit: [
                (100, MomentUpdated(moment_id: "m-handoff", lifecycle: Done,
                    kind: Handoff(from_device: "d-desk", to_device: "d-laptop", summary: "Continue reviewing the ledger draft"))),
            ],
        ),
        (
            on: Call(method: "handoff.decline", fields: {"moment_id": "m-handoff"}),
            emit: [
                (100, MomentUpdated(moment_id: "m-handoff", lifecycle: Dismissed)),
            ],
        ),
        (
            on: Call(method: "object.resolve_conflict", fields: {"moment_id": "m-conflict", "resolution": "KeepBoth"}),
            emit: [
                (100, MomentUpdated(moment_id: "m-conflict", lifecycle: Done,
                    kind: Conflict(
                        object_id: "o-budget",
                        local: (version: "v7", summary: "Edited on this laptop: groceries line",
                            lines: ["Rent, 1450", "Groceries, 520", "Utilities, 180", "Transport, 95"]),
                        remote: (version: "v8", summary: "Lena edited the utilities line",
                            lines: ["Rent, 1450", "Groceries, 480", "Utilities, 215", "Transport, 95"]),
                        resolution: KeepBoth,
                    ))),
            ],
        ),
        (
            on: Call(method: "object.resolve_conflict", fields: {"moment_id": "m-conflict", "resolution": "KeepLocal"}),
            emit: [
                (100, MomentUpdated(moment_id: "m-conflict", lifecycle: Done,
                    kind: Conflict(
                        object_id: "o-budget",
                        local: (version: "v7", summary: "Edited on this laptop: groceries line",
                            lines: ["Rent, 1450", "Groceries, 520", "Utilities, 180", "Transport, 95"]),
                        remote: (version: "v8", summary: "Lena edited the utilities line",
                            lines: ["Rent, 1450", "Groceries, 480", "Utilities, 215", "Transport, 95"]),
                        resolution: KeepLocal,
                    ))),
            ],
        ),
        (
            on: Call(method: "object.resolve_conflict", fields: {"moment_id": "m-conflict", "resolution": "KeepRemote"}),
            emit: [
                (100, MomentUpdated(moment_id: "m-conflict", lifecycle: Done,
                    kind: Conflict(
                        object_id: "o-budget",
                        local: (version: "v7", summary: "Edited on this laptop: groceries line",
                            lines: ["Rent, 1450", "Groceries, 520", "Utilities, 180", "Transport, 95"]),
                        remote: (version: "v8", summary: "Lena edited the utilities line",
                            lines: ["Rent, 1450", "Groceries, 480", "Utilities, 215", "Transport, 95"]),
                        resolution: KeepRemote,
                    ))),
            ],
        ),
        (
            on: Call(method: "privacy.reveal", fields: {"moment_id": "m-iban"}),
            emit: [
                (100, MomentUpdated(moment_id: "m-iban", lifecycle: Done,
                    kind: PrivacyReveal(
                        label: "Bank account number",
                        revealed: (by: "p-me", at: 0),
                        content: "XX00 0000 1111 2222 3333 44",
                    ))),
            ],
        ),
    ],
)
